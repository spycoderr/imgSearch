# Folder on the external drive that holds originals/ and derivatives/ (copy to .env and edit).
IMGSEARCH_STORAGE_ROOT=/Volumes/YOUR DRIVE/imgsearch
# S3 bucket for the encrypted originals and DB copy, and the AWS profile (in ~/.aws/) to use.
IMGSEARCH_S3_BUCKET=your-bucket-name
AWS_PROFILE=your-profile
# Syncthing's API key (Syncthing GUI > Actions > Settings), for `imgsearch backfill folders` only.
SYNCTHING_API_KEY=your-syncthing-api-key
# WhatsApp bot (`imgsearch serve`): from the Meta app's WhatsApp > API Setup page.
WHATSAPP_TOKEN=your-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_VERIFY_TOKEN=any-long-random-string-you-also-enter-in-the-webhook-setup
# Comma-separated numbers allowed to search, with country code, e.g. 919812345678,919800000000
WHATSAPP_ALLOWED_SENDERS=91XXXXXXXXXX
